modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "calculator-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "idalia-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "calculate-auth-integration"

[[workflows.workflow]]
name = "calculator-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:calculators"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "idalia-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/idalia typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "calculate-auth-integration"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:calculate-auth"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 18522
externalPort = 3000

[[ports]]
localPort = 21108
externalPort = 3002

[[ports]]
localPort = 22196
externalPort = 3003

[[ports]]
localPort = 25496
externalPort = 80

[[ports]]
localPort = 25760
externalPort = 3001

[userenv]

[userenv.production]
APP_ORIGIN = "https://idcalc.com"
